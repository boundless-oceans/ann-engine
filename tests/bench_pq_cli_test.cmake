# 验证PQ码长/LUT元数据、单次构建扫描及参数边界，不引入Python依赖。
if(NOT DEFINED ANN_BENCH)
    message(FATAL_ERROR "ANN_BENCH executable is required")
endif()
set(result_dir "${CMAKE_CURRENT_BINARY_DIR}/bench-pq-cli-results")
file(MAKE_DIRECTORY "${result_dir}")
set(common --index ivf --quantizer pq --n 256 --nq 12 --dim 16 --k 3
           --nlist 8 --pq-m 4 --pq-ksub 16 --kmeans-iters 3 --warmup 0 --runs 1)
execute_process(COMMAND "${ANN_BENCH}" ${common} --nprobe-list 1,8,16,1
                        --csv "${result_dir}/sweep.csv"
                RESULT_VARIABLE status OUTPUT_VARIABLE console ERROR_VARIABLE progress)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "PQ sweep failed: ${progress}")
endif()
if(NOT console MATCHES "computed independently with FlatIndex")
    message(FATAL_ERROR "PQ must use independent Flat ground truth")
endif()
string(REGEX MATCHALL "Build completed" builds "${progress}")
list(LENGTH builds build_count)
if(NOT build_count EQUAL 1)
    message(FATAL_ERROR "PQ sweep must train/build once")
endif()
file(STRINGS "${result_dir}/sweep.csv" rows)
list(LENGTH rows row_count)
if(NOT row_count EQUAL 5)
    message(FATAL_ERROR "PQ CSV must contain four measurements")
endif()
list(GET rows 0 header)
if(NOT header MATCHES ",quantizer,encoding,code_size,lut_floats,pq_m,pq_ksub$")
    message(FATAL_ERROR "PQ metadata is missing")
endif()
set(expected_probes 1 8 16 1)
foreach(i RANGE 0 3)
    math(EXPR row_index "${i} + 1")
    list(GET rows ${row_index} row)
    string(REPLACE "," ";" cells "${row}")
    list(LENGTH cells columns)
    if(NOT columns EQUAL 33)
        message(FATAL_ERROR "Unexpected PQ CSV column count")
    endif()
    list(GET cells 0 index)
    list(GET cells 14 build_seconds)
    list(GET cells 15 memory)
    list(GET cells 16 recall)
    list(GET cells 17 qps)
    list(GET cells 24 probes)
    list(GET cells 25 effective)
    list(GET cells 27 quantizer)
    list(GET cells 28 encoding)
    list(GET cells 29 code_size)
    list(GET cells 30 lut_floats)
    list(GET cells 31 pq_m)
    list(GET cells 32 pq_ksub)
    list(GET expected_probes ${i} expected)
    if(NOT index STREQUAL "IVFPQ" OR NOT quantizer STREQUAL "pq" OR
       NOT encoding STREQUAL "residual" OR NOT code_size EQUAL 4 OR
       NOT lut_floats EQUAL 64 OR NOT pq_m EQUAL 4 OR NOT pq_ksub EQUAL 16 OR
       NOT probes EQUAL expected OR NOT qps GREATER 0 OR NOT recall GREATER 0 OR recall GREATER 1)
        message(FATAL_ERROR "Invalid PQ metadata")
    endif()
    if(i EQUAL 0)
        set(first_recall "${recall}")
        set(first_build "${build_seconds}")
        set(first_memory "${memory}")
        if(NOT effective EQUAL 1 OR NOT recall LESS 1)
            message(FATAL_ERROR "Narrow PQ probing must use an independent reference")
        endif()
    elseif(i EQUAL 3)
        if(NOT recall STREQUAL first_recall OR NOT effective EQUAL 1)
            message(FATAL_ERROR "Repeated probe count must reproduce PQ recall")
        endif()
    else()
        if(NOT effective EQUAL 8)
            message(FATAL_ERROR "PQ probe count must clamp to nlist")
        endif()
        if(i EQUAL 1)
            set(all_recall "${recall}")
        elseif(NOT recall STREQUAL all_recall)
            message(FATAL_ERROR "Clamped and full probing must agree")
        endif()
    endif()
    if(NOT build_seconds STREQUAL first_build OR NOT memory STREQUAL first_memory)
        message(FATAL_ERROR "PQ sweep must preserve build metadata")
    endif()
endforeach()

execute_process(COMMAND "${ANN_BENCH}" ${common} --nprobe 8
                        --csv "${result_dir}/single.csv"
                RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE progress)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Single PQ measurement failed: ${progress}")
endif()
file(STRINGS "${result_dir}/single.csv" rows)
list(GET rows 1 row)
string(REPLACE "," ";" cells "${row}")
list(GET cells 16 recall)
if(NOT recall STREQUAL all_recall)
    message(FATAL_ERROR "Single and sweep PQ recall must agree")
endif()

# 不显式指定ksub时必须使用256，不能跟随粗聚类nlist或样本数静默缩小。
execute_process(COMMAND "${ANN_BENCH}" --index ivf --quantizer pq --n 256 --nq 2
                        --dim 4 --pq-m 2 --nlist 2 --kmeans-iters 1 --nprobe 2
                        --k 1 --warmup 0 --runs 1 --csv "${result_dir}/default.csv"
                RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE progress)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Default PQ codebook failed: ${progress}")
endif()
file(STRINGS "${result_dir}/default.csv" rows)
list(GET rows 1 row)
string(REPLACE "," ";" cells "${row}")
list(GET cells 31 pq_m)
list(GET cells 32 pq_ksub)
list(GET cells 30 lut_floats)
if(NOT pq_m EQUAL 2 OR NOT pq_ksub EQUAL 256 OR NOT lut_floats EQUAL 512)
    message(FATAL_ERROR "PQ defaults must record the actual codebook shape")
endif()

foreach(option IN ITEMS --pq-m --pq-ksub)
    foreach(invalid IN ITEMS "" "0" "-1" "abc" "2x" "+2" "1,2" "18446744073709551616")
        execute_process(COMMAND "${ANN_BENCH}" ${common} ${option} "${invalid}"
                        RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
        if(status EQUAL 0)
            message(FATAL_ERROR "Malformed PQ parameter must fail: ${option} '${invalid}'")
        endif()
    endforeach()
    execute_process(COMMAND "${ANN_BENCH}" ${common} ${option}
                    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(status EQUAL 0)
        message(FATAL_ERROR "Missing PQ parameter must fail")
    endif()
endforeach()
foreach(case IN ITEMS no_pq sq8 flat hnsw metric uneven too_many_centers not_enough_data conflict)
    if(case STREQUAL "no_pq")
        set(extra --quantizer none)
    elseif(case STREQUAL "sq8")
        set(extra --quantizer sq8)
    elseif(case STREQUAL "flat")
        set(extra --index flat)
    elseif(case STREQUAL "hnsw")
        set(extra --index hnsw)
    elseif(case STREQUAL "metric")
        set(extra --metric ip)
    elseif(case STREQUAL "uneven")
        set(extra --pq-m 3)
    elseif(case STREQUAL "too_many_centers")
        set(extra --pq-ksub 257)
    elseif(case STREQUAL "not_enough_data")
        set(extra --n 8)
    else()
        set(extra --nprobe 1 --nprobe-list 1,8)
    endif()
    execute_process(COMMAND "${ANN_BENCH}" ${common} ${extra}
                    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(status EQUAL 0)
        message(FATAL_ERROR "Incompatible PQ parameters must fail: ${case}")
    endif()
endforeach()
