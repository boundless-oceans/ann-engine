# 以独立进程验证扫描、CSV 与单次建图，不引入额外测试依赖。
if(NOT DEFINED ANN_BENCH)
    message(FATAL_ERROR "ANN_BENCH executable is required")
endif()

set(result_dir "${CMAKE_CURRENT_BINARY_DIR}/bench-cli-results")
file(MAKE_DIRECTORY "${result_dir}")
set(common --index hnsw --n 128 --nq 8 --dim 8 --k 3 --m 4 --warmup 0 --runs 1)
execute_process(
    COMMAND "${ANN_BENCH}" ${common} --ef-search-list 2,8,2 --csv "${result_dir}/sweep.csv"
    RESULT_VARIABLE status OUTPUT_VARIABLE console ERROR_VARIABLE progress
)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Sweep failed: ${status}\n${progress}")
endif()
string(REGEX MATCHALL "Build completed" builds "${progress}")
list(LENGTH builds build_count)
if(NOT build_count EQUAL 1)
    message(FATAL_ERROR "Sweep must build exactly once")
endif()
file(STRINGS "${result_dir}/sweep.csv" rows)
list(LENGTH rows row_count)
if(NOT row_count EQUAL 4)
    message(FATAL_ERROR "CSV must contain a header and three measurements")
endif()
list(GET rows 0 header)
if(NOT header MATCHES "^index,metric,n,dim,nq,k,M,Mmax0,ef_construction,ef_search,effective_ef_search,")
    message(FATAL_ERROR "Unexpected CSV header")
endif()
set(expected_ef 2 8 2)
foreach(i RANGE 0 2)
    math(EXPR row_index "${i} + 1")
    list(GET rows ${row_index} row)
    string(REPLACE "," ";" cells "${row}")
    list(LENGTH cells columns)
    if(NOT columns EQUAL 33)
        message(FATAL_ERROR "Unexpected CSV column count: ${columns}")
    endif()
    list(GET cells 9 ef)
    list(GET cells 10 effective_ef)
    list(GET cells 14 build_seconds)
    list(GET cells 15 memory_bytes)
    list(GET cells 16 recall)
    list(GET cells 17 qps)
    list(GET expected_ef ${i} expected)
    if(NOT ef EQUAL expected OR effective_ef LESS 3 OR NOT qps GREATER 0)
        message(FATAL_ERROR "Invalid ef, effective width, or QPS")
    endif()
    if(i EQUAL 0)
        set(first_recall "${recall}")
        set(first_build "${build_seconds}")
        set(first_memory "${memory_bytes}")
    elseif(i EQUAL 1)
        set(middle_recall "${recall}")
    elseif(NOT recall STREQUAL first_recall)
        message(FATAL_ERROR "Repeated ef must reproduce the same strict recall")
    endif()
    if(NOT build_seconds STREQUAL first_build OR NOT memory_bytes STREQUAL first_memory)
        message(FATAL_ERROR "Sweep must preserve build metadata")
    endif()
endforeach()

# 单值入口与扫描中相同 ef 的召回应一致，验证各轮状态没有相互污染。
execute_process(
    COMMAND "${ANN_BENCH}" ${common} --ef-search 8 --csv "${result_dir}/single.csv"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE progress
)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Single measurement failed: ${progress}")
endif()
file(STRINGS "${result_dir}/single.csv" single_rows)
list(GET single_rows 1 row)
string(REPLACE "," ";" cells "${row}")
list(GET cells 16 single_recall)
if(NOT single_recall STREQUAL middle_recall)
    message(FATAL_ERROR "Single and sweep recall must match")
endif()

foreach(invalid IN ITEMS "" "0" "-1" "1," ",1" "1,,2" "abc" "2x" "18446744073709551616" "1, 2")
    execute_process(
        COMMAND "${ANN_BENCH}" ${common} --ef-search-list "${invalid}"
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET
    )
    if(status EQUAL 0)
        message(FATAL_ERROR "Malformed ef list must fail: '${invalid}'")
    endif()
endforeach()
foreach(extra IN ITEMS "flat" "conflict" "missing")
    if(extra STREQUAL "flat")
        set(args --index flat --ef-search-list 4,8)
    elseif(extra STREQUAL "conflict")
        set(args --ef-search 4 --ef-search-list 4,8)
    else()
        set(args --ef-search-list)
    endif()
    execute_process(COMMAND "${ANN_BENCH}" ${common} ${args}
                    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(status EQUAL 0)
        message(FATAL_ERROR "Incompatible or missing sweep options must fail")
    endif()
endforeach()
