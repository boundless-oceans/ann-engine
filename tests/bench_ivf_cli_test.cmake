# 验证同一索引扫描、严格参考和 IVF 参数边界，无额外 Python 依赖。
if(NOT DEFINED ANN_BENCH)
    message(FATAL_ERROR "ANN_BENCH executable is required")
endif()

set(result_dir "${CMAKE_CURRENT_BINARY_DIR}/bench-ivf-cli-results")
file(MAKE_DIRECTORY "${result_dir}")
set(common --index ivf --n 256 --nq 12 --dim 8 --k 3
           --nlist 8 --kmeans-iters 3 --warmup 0 --runs 1)
execute_process(
    COMMAND "${ANN_BENCH}" ${common} --nprobe-list 1,8,16,1 --csv "${result_dir}/sweep.csv"
    RESULT_VARIABLE status OUTPUT_VARIABLE console ERROR_VARIABLE progress
)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "IVF sweep failed: ${status}\n${progress}")
endif()
string(REGEX MATCHALL "Build completed" builds "${progress}")
list(LENGTH builds build_count)
if(NOT build_count EQUAL 1)
    message(FATAL_ERROR "IVF sweep must train/build exactly once")
endif()
if(NOT console MATCHES "computed independently with FlatIndex")
    message(FATAL_ERROR "IVF must report independent Flat ground truth")
endif()
file(STRINGS "${result_dir}/sweep.csv" rows)
list(LENGTH rows row_count)
if(NOT row_count EQUAL 5)
    message(FATAL_ERROR "CSV must contain header and four measurements")
endif()
list(GET rows 0 header)
if(NOT header MATCHES ",nlist,nprobe,effective_nprobe,kmeans_iters$")
    message(FATAL_ERROR "Missing IVF CSV fields")
endif()
set(expected_probes 1 8 16 1)
foreach(i RANGE 0 3)
    math(EXPR row_index "${i} + 1")
    list(GET rows ${row_index} row)
    string(REPLACE "," ";" cells "${row}")
    list(LENGTH cells columns)
    if(NOT columns EQUAL 27)
        message(FATAL_ERROR "Unexpected IVF CSV column count")
    endif()
    list(GET cells 0 index)
    list(GET cells 14 build_seconds)
    list(GET cells 15 memory_bytes)
    list(GET cells 16 recall)
    list(GET cells 17 qps)
    list(GET cells 23 nlist)
    list(GET cells 24 probes)
    list(GET cells 25 effective)
    list(GET cells 26 iters)
    list(GET expected_probes ${i} expected)
    if(NOT index STREQUAL "IVFFlat" OR NOT nlist EQUAL 8 OR NOT iters EQUAL 3
       OR NOT probes EQUAL expected OR NOT qps GREATER 0)
        message(FATAL_ERROR "Invalid IVF metadata")
    endif()
    foreach(column RANGE 6 10)
        list(GET cells ${column} hnsw_value)
        if(NOT hnsw_value EQUAL 0)
            message(FATAL_ERROR "IVF rows must not contain HNSW parameter values")
        endif()
    endforeach()
    if(i EQUAL 0)
        set(first_recall "${recall}")
        set(first_build "${build_seconds}")
        set(first_memory "${memory_bytes}")
        if(NOT effective EQUAL 1 OR NOT recall LESS 1)
            message(FATAL_ERROR "Narrow probing must use independent reference, not self-recall")
        endif()
    elseif(i EQUAL 3)
        if(NOT effective EQUAL 1 OR NOT recall STREQUAL first_recall)
            message(FATAL_ERROR "Repeated probe count must reproduce strict recall")
        endif()
    elseif(NOT effective EQUAL 8 OR NOT recall EQUAL 1)
        message(FATAL_ERROR "All-list probing must recover exact fixture results")
    endif()
    if(NOT build_seconds STREQUAL first_build OR NOT memory_bytes STREQUAL first_memory)
        message(FATAL_ERROR "IVF sweep must preserve build metadata")
    endif()
endforeach()

# 单值路径和请求值超过 nlist 的截断行为。
execute_process(
    COMMAND "${ANN_BENCH}" ${common} --nprobe 16 --csv "${result_dir}/single.csv"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE progress
)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Single IVF measurement failed: ${progress}")
endif()
file(STRINGS "${result_dir}/single.csv" rows)
list(GET rows 1 row)
string(REPLACE "," ";" cells "${row}")
list(GET cells 16 recall)
list(GET cells 24 probes)
list(GET cells 25 effective)
if(NOT recall EQUAL 1 OR NOT probes EQUAL 16 OR NOT effective EQUAL 8)
    message(FATAL_ERROR "Single probe metadata/recall does not match sweep")
endif()

foreach(option IN ITEMS --nprobe-list --nprobe --nlist --kmeans-iters)
    foreach(invalid IN ITEMS "" "0" "-1" "1," ",1" "1,,2" "abc" "2x"
                             "18446744073709551616" "1, 2" "+2" " 2")
        execute_process(COMMAND "${ANN_BENCH}" ${common} ${option} "${invalid}"
                        RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
        if(status EQUAL 0)
            message(FATAL_ERROR "Malformed IVF parameter must fail: ${option} '${invalid}'")
        endif()
    endforeach()
    execute_process(COMMAND "${ANN_BENCH}" ${common} ${option}
                    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(status EQUAL 0)
        message(FATAL_ERROR "Missing IVF parameter must fail: ${option}")
    endif()
endforeach()
foreach(case IN ITEMS conflict flat hnsw metric hnsw_flags too_many)
    if(case STREQUAL "conflict")
        set(extra --nprobe 1 --nprobe-list 1,2)
    elseif(case STREQUAL "flat")
        set(extra --index flat)
    elseif(case STREQUAL "hnsw")
        set(extra --index hnsw)
    elseif(case STREQUAL "metric")
        set(extra --metric ip)
    elseif(case STREQUAL "hnsw_flags")
        set(extra --m 4)
    else()
        set(extra --nlist 257)
    endif()
    execute_process(COMMAND "${ANN_BENCH}" ${common} ${extra}
                    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(status EQUAL 0)
        message(FATAL_ERROR "Incompatible IVF options must fail: ${case}")
    endif()
endforeach()

# Flat 的默认入口及其 CSV 原有字段继续可用，新 IVF 列应为零。
execute_process(COMMAND "${ANN_BENCH}" --n 32 --nq 2 --dim 4 --k 2
                        --warmup 0 --runs 1 --csv "${result_dir}/flat.csv"
                RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Default Flat benchmark must still work")
endif()
file(STRINGS "${result_dir}/flat.csv" rows)
list(GET rows 1 row)
string(REPLACE "," ";" cells "${row}")
list(GET cells 0 index)
if(NOT index STREQUAL "Flat")
    message(FATAL_ERROR "Default index must remain Flat")
endif()
foreach(column RANGE 23 26)
    list(GET cells ${column} value)
    if(NOT value EQUAL 0)
        message(FATAL_ERROR "Flat CSV must contain zero IVF metadata")
    endif()
endforeach()
