# 验证残差 SQ8 入口、严格独立参考、CSV 和原始存储释放。
if(NOT DEFINED ANN_BENCH)
    message(FATAL_ERROR "ANN_BENCH executable is required")
endif()
set(result_dir "${CMAKE_CURRENT_BINARY_DIR}/bench-sq8-cli-results")
file(MAKE_DIRECTORY "${result_dir}")
set(common --index ivf --n 256 --nq 12 --dim 8 --k 3 --nlist 8
           --kmeans-iters 3 --warmup 0 --runs 1)
execute_process(
    COMMAND "${ANN_BENCH}" ${common} --quantizer sq8 --nprobe-list 1,8,16,1
            --csv "${result_dir}/sq8.csv"
    RESULT_VARIABLE status OUTPUT_VARIABLE console ERROR_VARIABLE progress
)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "SQ8 sweep failed: ${progress}")
endif()
if(NOT console MATCHES "computed independently with FlatIndex")
    message(FATAL_ERROR "SQ8 must use an independent Flat reference")
endif()
string(REGEX MATCHALL "Build completed" builds "${progress}")
list(LENGTH builds build_count)
if(NOT build_count EQUAL 1)
    message(FATAL_ERROR "SQ8 sweep must train/build once")
endif()
file(STRINGS "${result_dir}/sq8.csv" rows)
list(LENGTH rows row_count)
if(NOT row_count EQUAL 5)
    message(FATAL_ERROR "SQ8 CSV must contain four measurements")
endif()
list(GET rows 0 header)
if(NOT header MATCHES ",quantizer,encoding,code_size,lut_floats$")
    message(FATAL_ERROR "SQ8 metadata is missing")
endif()
set(expected_probes 1 8 16 1)
foreach(i RANGE 0 3)
    math(EXPR row_index "${i} + 1")
    list(GET rows ${row_index} row)
    string(REPLACE "," ";" cells "${row}")
    list(LENGTH cells columns)
    if(NOT columns EQUAL 31)
        message(FATAL_ERROR "Unexpected SQ8 CSV column count")
    endif()
    list(GET cells 0 index)
    list(GET cells 14 build_seconds)
    list(GET cells 15 memory)
    list(GET cells 16 recall)
    list(GET cells 17 qps)
    list(GET cells 24 probes)
    list(GET cells 25 effective)
    list(GET cells 27 quantizer)
    list(GET cells 28 encoding)
    list(GET cells 29 code_size)
    list(GET cells 30 lut_floats)
    list(GET expected_probes ${i} expected)
    if(NOT index STREQUAL "IVFSQ8" OR NOT quantizer STREQUAL "sq8" OR
       NOT encoding STREQUAL "residual" OR NOT code_size EQUAL 8 OR
       NOT lut_floats EQUAL 2048 OR NOT probes EQUAL expected OR
       NOT qps GREATER 0 OR NOT recall GREATER 0 OR recall GREATER 1)
        message(FATAL_ERROR "Invalid SQ8 measurement metadata")
    endif()
    if(i EQUAL 0)
        set(first_recall "${recall}")
        set(first_build "${build_seconds}")
        set(first_memory "${memory}")
        if(NOT effective EQUAL 1 OR NOT recall LESS 1)
            message(FATAL_ERROR "Narrow SQ8 probing must not use itself as ground truth")
        endif()
    elseif(i EQUAL 3)
        if(NOT recall STREQUAL first_recall OR NOT effective EQUAL 1)
            message(FATAL_ERROR "Repeated probe count must reproduce recall")
        endif()
    else()
        if(NOT effective EQUAL 8)
            message(FATAL_ERROR "Effective probe count must clamp to nlist")
        endif()
        if(i EQUAL 1)
            set(all_recall "${recall}")
        elseif(NOT recall STREQUAL all_recall)
            message(FATAL_ERROR "Clamped and all-list recall must agree")
        endif()
    endif()
    if(NOT build_seconds STREQUAL first_build OR NOT memory STREQUAL first_memory)
        message(FATAL_ERROR "SQ8 sweep must preserve build metadata")
    endif()
endforeach()

execute_process(COMMAND "${ANN_BENCH}" ${common} --quantizer sq8 --nprobe 8
                        --csv "${result_dir}/single.csv"
                RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE progress)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Single SQ8 measurement failed: ${progress}")
endif()
file(STRINGS "${result_dir}/single.csv" rows)
list(GET rows 1 row)
string(REPLACE "," ";" cells "${row}")
list(GET cells 16 recall)
if(NOT recall STREQUAL all_recall)
    message(FATAL_ERROR "Single and sweep SQ8 recall must match")
endif()

execute_process(COMMAND "${ANN_BENCH}" ${common} --quantizer none --nprobe 8
                        --csv "${result_dir}/raw.csv"
                RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE progress)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Explicit unquantized IVF failed: ${progress}")
endif()
file(STRINGS "${result_dir}/raw.csv" rows)
list(GET rows 1 row)
string(REPLACE "," ";" cells "${row}")
list(GET cells 0 index)
list(GET cells 15 raw_memory)
list(GET cells 27 quantizer)
list(GET cells 28 encoding)
list(GET cells 29 code_size)
list(GET cells 30 lut_floats)
if(NOT index STREQUAL "IVFFlat" OR NOT quantizer STREQUAL "none" OR
   NOT encoding STREQUAL "raw" OR NOT code_size EQUAL 0 OR NOT lut_floats EQUAL 0 OR
   NOT first_memory LESS raw_memory)
    message(FATAL_ERROR "Unquantized metadata or SQ8 storage release is incorrect")
endif()

foreach(case IN ITEMS unknown empty missing flat hnsw metric conflict)
    if(case STREQUAL "unknown")
        set(extra --quantizer pq)
    elseif(case STREQUAL "empty")
        set(extra --quantizer "")
    elseif(case STREQUAL "missing")
        set(extra --quantizer)
    elseif(case STREQUAL "flat")
        set(extra --quantizer sq8 --index flat)
    elseif(case STREQUAL "hnsw")
        set(extra --quantizer sq8 --index hnsw)
    elseif(case STREQUAL "metric")
        set(extra --quantizer sq8 --metric ip)
    else()
        set(extra --quantizer sq8 --nprobe 1 --nprobe-list 1,8)
    endif()
    execute_process(COMMAND "${ANN_BENCH}" ${common} ${extra}
                    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(status EQUAL 0)
        message(FATAL_ERROR "Invalid SQ8 options must fail: ${case}")
    endif()
endforeach()
